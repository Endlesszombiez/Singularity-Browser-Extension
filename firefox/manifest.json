{
  "manifest_version": 2,
  "name": "Singularity Katana Panel",
  "description": "Injects a Singularity data panel into Katana sales order pages after API key verification.",
  "version": "0.1.0",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "storage",
    "https://factory.katanamrp.com/salesorder/*",
    "https://botanaway.method.me/apps/*",
    "https://singularitysalesplatform.com/*",
    "https://*/wp-json/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://factory.katanamrp.com/salesorder/*",
        "https://botanaway.method.me/apps/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "images/CompanyLogo.png"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_title": "Singularity Katana Panel",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "96": "images/icon-96.png",
      "128": "images/icon-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "singularity-katana-panel@example.com"
    }
  }
}
